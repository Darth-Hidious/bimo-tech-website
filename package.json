{
  "name": "bimo-materials-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --no-warnings scripts/i18n.mjs check && next build",
    "lint": "tsc --noEmit",
    "i18n": "node --no-warnings scripts/i18n.mjs extract",
    "check": "node --no-warnings scripts/check-out.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.1",
    "@fontsource/google-sans": "^5.3.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
