# Settings for the Bimo Materials website. Template only: no real values here.
#
# On Vercel: Project → Settings → Environment Variables → Production, one row per variable,
# then Deployments → newest → ⋯ → Redeploy. (Vercel CLI: `vercel env add RESEND_API_KEY production`.)
# Locally: copy this file to .env.local, which git ignores, and fill it in.
# Never commit a real key: the repository may change hands, the Vercel settings stay with the project.

# Required for the quote form to send email. Resend → API Keys → Create API key (Sending access),
# on the Resend account where bimomaterials.com is verified.
RESEND_API_KEY=re_your_key_here

# Optional. The site's address; Vercel works it out from the project's domain (bimomaterials.com).
# SITE_URL=bimomaterials.com

# Optional. Defaults are info@bimomaterials.com for the address shown on the site, the inbox and
# the sender. Leave unset unless that should change.
# CONTACT_EMAIL=info@bimomaterials.com
# QUOTE_TO=info@bimomaterials.com
# QUOTE_FROM=Bimo Materials <info@bimomaterials.com>
